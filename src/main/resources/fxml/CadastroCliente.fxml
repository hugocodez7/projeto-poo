<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.edu.ifpb.ads.foodjava.controller.CadastroClienteController">
    <children>
        <VBox alignment="CENTER" layoutX="300.0" layoutY="80.0" prefWidth="300.0" spacing="12.0">
            <children>
                <Label text="Cadastro de Cliente">
                    <font><Font size="22.0" /></font>
                </Label>

                <Label text="Nome:" />
                <TextField fx:id="txNome" promptText="Digite seu nome" />

                <Label text="E-mail:" />
                <TextField fx:id="txEmail" promptText="Digite seu e-mail" />

                <Label text="Senha:" />
                <PasswordField fx:id="txSenha" promptText="Digite sua senha" />

                <Label text="CPF:" />
                <TextField fx:id="txCpf" promptText="000.000.000-00" />

                <Label text="Telefone:" />
                <TextField fx:id="txTelefone" promptText="Digite seu telefone" />

                <Label text="Endereço:" />
                <TextField fx:id="txEndereco" promptText="Digite seu endereço" />

                <Button fx:id="btnCadastrar" mnemonicParsing="false"
                        onAction="#cadastrar" text="Cadastrar"
                        prefWidth="200.0" />

                <Button fx:id="btnVoltar" mnemonicParsing="false"
                        onAction="#voltar" text="Voltar ao Login"
                        prefWidth="200.0" />
            </children>
        </VBox>
    </children>
</AnchorPane>