<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.edu.ifpb.ads.foodjava.controller.CadastroClienteController">
    <VBox alignment="CENTER" maxWidth="320.0" spacing="10.0">
        <Label text="Cadastro de Cliente">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>
        <Label text="Nome:"/>
        <TextField fx:id="txNome" promptText="Digite seu nome" maxWidth="300.0"/>
        <Label text="E-mail:"/>
        <TextField fx:id="txEmail" promptText="Digite seu e-mail" maxWidth="300.0"/>
        <Label text="Senha:"/>
        <PasswordField fx:id="txSenha" promptText="Digite sua senha" maxWidth="300.0"/>
        <Label text="CPF:"/>
        <TextField fx:id="txCpf" promptText="000.000.000-00" maxWidth="300.0"/>
        <Label text="Telefone:"/>
        <TextField fx:id="txTelefone" promptText="Digite seu telefone" maxWidth="300.0"/>
        <Label text="Endereço:"/>
        <TextField fx:id="txEndereco" promptText="Digite seu endereço" maxWidth="300.0"/>
        <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="btnCadastrar" text="Cadastrar" onAction="#cadastrar" prefWidth="135.0"/>
            <Button fx:id="btnVoltar" text="Voltar" onAction="#voltar" prefWidth="135.0"/>
        </HBox>
    </VBox>
</StackPane>
