<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.ifpb.ads.foodjava.controller.HistoricoClienteController" prefWidth="900.0"
            prefHeight="600.0">
    <StackPane AnchorPane.topAnchor="25.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0"
               AnchorPane.bottomAnchor="25.0">
        <VBox spacing="18.0" maxWidth="760.0">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Histórico de Pedidos" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVoltar" text="Voltar ao Cardápio" onAction="#voltar"/>
                <Button text="Sair" onAction="#sair"/>
            </HBox>
            <TableView fx:id="tabelaHistorico" prefHeight="400.0">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80.0"/>
                    <TableColumn fx:id="colData" text="Data/Hora" prefWidth="200.0"/>
                    <TableColumn fx:id="colValor" text="Valor Total" prefWidth="160.0"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="220.0"/>
                </columns>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label fx:id="lblMensagem" text="Acompanhe aqui o status dos seus pedidos."
                       style="-fx-text-fill: #666;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar Pedido" onAction="#cancelarPedido"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>
