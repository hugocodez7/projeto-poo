<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.ifpb.ads.foodjava.controller.CardapioController"
            prefHeight="400.0"
            prefWidth="600.0">

    <BorderPane prefHeight="400.0" prefWidth="600.0">

        <top>
            <ToolBar prefHeight="40.0">
                <items>
                    <TextField fx:id="campoBusca" promptText="Buscar item..." />

                    <Button fx:id="adicionar"
                            text="Adicionar"
                            mnemonicParsing="false"
                            onAction="#abrirFormularioAdicionar" />

                    <Button fx:id="editar"
                            text="Editar"
                            mnemonicParsing="false"
                            onAction="#abrirFormularioEditar" />

                    <Button fx:id="remover"
                            text="Remover"
                            mnemonicParsing="false"
                            onAction="#removerItem" />
                </items>
            </ToolBar>
        </top>

        <center>
            <TableView fx:id="tabelaCardapio" prefHeight="360.0" prefWidth="600.0">
                <columns>
                    <TableColumn fx:id="colunaNome" prefWidth="160.0" text="Nome" />
                    <TableColumn fx:id="colunaCategoria" prefWidth="140.0" text="Categoria" />
                    <TableColumn fx:id="colunaPreco" prefWidth="140.0" text="Preço" />
                    <TableColumn fx:id="colunaDisponivel" prefWidth="160.0" text="Disponível" />
                </columns>
            </TableView>
        </center>

    </BorderPane>

</AnchorPane>