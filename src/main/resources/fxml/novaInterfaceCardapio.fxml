<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.ifpb.ads.foodjava.controller.CardapioController"
            prefHeight="600.0"
            prefWidth="900.0">

    <top>
        <ToolBar prefHeight="50.0">
            <items>
                <!-- Campo de busca -->
                <TextField fx:id="campoBusca"
                           promptText="Buscar item..."
                           prefWidth="200.0"/>

                <!-- Botões do Gerente -->
                <Button fx:id="adicionar"
                        text="Adicionar"
                        onAction="#abrirFormularioAdicionar"/>

                <Button fx:id="editar"
                        text="Editar"
                        onAction="#abrirFormularioEditar"/>

                <Button fx:id="remover"
                        text="Remover"
                        onAction="#removerItem"/>

                <Button fx:id="importar"
                        text="Importar JSON"
                        onAction="#importarCardapio"/>
            </items>
        </ToolBar>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    BorderPane.alignment="CENTER">
            <content>
                <FlowPane fx:id="painelCards"
                          hgap="16"
                          vgap="16"
                          prefWrapLength="800">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>