<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.edu.ifpb.ads.foodjava.controller.ConfiguracaoRestauranteController">
    <VBox alignment="CENTER" maxWidth="320.0" spacing="10.0">
        <Label text="Configurações do Restaurante">
            <font>
                <Font size="20.0"/>
            </font>
        </Label>
        <Label text="Nome:"/>
        <TextField fx:id="txNome" promptText="Nome do restaurante" maxWidth="300.0"/>
        <Label text="CNPJ:"/>
        <TextField fx:id="txCnpj" promptText="00.000.000/0000-00" maxWidth="300.0"/>
        <Label text="Endereço:"/>
        <TextField fx:id="txEndereco" promptText="Endereço completo" maxWidth="300.0"/>
        <Label text="Telefone:"/>
        <TextField fx:id="txTelefone" promptText="Telefone" maxWidth="300.0"/>
        <Label text="Categoria Culinária:"/>
        <TextField fx:id="txCategoria" promptText="Ex: Nordestina" maxWidth="300.0"/>
        <Label text="E-mail:"/>
        <TextField fx:id="txEmail" promptText="E-mail" maxWidth="300.0"/>
        <Label text="Nova Senha:"/>
        <PasswordField fx:id="txSenha" promptText="Deixe em branco para manter" maxWidth="300.0"/>
        <HBox alignment="CENTER" spacing="15.0">
            <Button text="Salvar Alterações" onAction="#salvar" prefWidth="150.0"/>
            <Button fx:id="btnVoltar" text="Voltar" onAction="#voltar" prefWidth="100.0"/>
        </HBox>
    </VBox>
</StackPane>
