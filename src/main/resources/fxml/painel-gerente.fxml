<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.ifpb.ads.foodjava.controller.PainelGerenteController"
            prefHeight="500.0"
            prefWidth="800.0">

    <VBox spacing="15"
          AnchorPane.topAnchor="20"
          AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20"
          AnchorPane.bottomAnchor="20">

        <Label text="Painel do Gerente"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <HBox spacing="10">

            <Label text="Filtrar por status:" />

            <ComboBox fx:id="comboStatus"
                      prefWidth="250" />

            <Button text="Filtrar"
                    fx:id="btnFiltrar" />

            <Button text="Atualizar"
                    fx:id="btnAtualizar" />

        </HBox>

        <TableView fx:id="tabelaPedidos"
                   prefHeight="300">

            <columns>

                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="80" />

                <TableColumn fx:id="colData"
                             text="Data/Hora"
                             prefWidth="180" />

                <TableColumn fx:id="colValor"
                             text="Valor Total"
                             prefWidth="120" />

                <TableColumn fx:id="colStatus"
                             text="Status"
                             prefWidth="200" />

            </columns>

        </TableView>

        <HBox spacing="20">

            <Label fx:id="lblTotalPedidos"
                   text="Total de pedidos: 0" />

            <Label fx:id="lblFaturamento"
                   text="Faturamento: R$ 0,00" />

            <Button text="Avançar Status"
                    fx:id="btnAvancarStatus" />

        </HBox>

    </VBox>

</AnchorPane>