<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.edu.ifpb.ads.foodjava.controller.CarrinhoController" prefWidth="900.0" prefHeight="600.0">
    <StackPane AnchorPane.topAnchor="25.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0"
               AnchorPane.bottomAnchor="25.0">
        <VBox spacing="18.0" maxWidth="760.0">
            <HBox alignment="CENTER_LEFT" spacing="20.0">
                <Label text="Meu Carrinho" style="-fx-font-size: 26px; -fx-font-weight: bold;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnVoltar" text="Voltar ao Cardápio" onAction="#voltar"/>
            </HBox>
            <TableView fx:id="tabelaCarrinho" prefHeight="400.0">
                <columns>
                    <TableColumn fx:id="colItem" text="Item" prefWidth="300.0"/>
                    <TableColumn fx:id="colQuantidade" text="Quantidade" prefWidth="130.0"/>
                    <TableColumn fx:id="colPreco" text="Preço Unitário" prefWidth="160.0"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="160.0"/>
                </columns>
            </TableView>
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button text="Remover Item" onAction="#removerItemSelecionado"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" text="Total: R$ 0,00" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Button fx:id="btnFinalizarPedido" text="Finalizar Pedido" onAction="#finalizarPedido"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </StackPane>
</AnchorPane>
