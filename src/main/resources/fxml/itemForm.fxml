<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="520.0" prefWidth="600.0" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.edu.ifpb.ads.foodjava.controller.ItemFormController">
    <VBox alignment="CENTER" maxWidth="400.0" spacing="10.0">
        <Label text="Item do Cardápio">
            <font>
                <Font size="20.0"/>
            </font>
        </Label>
        <Label text="Nome:"/>
        <TextField fx:id="nome" promptText="Nome do item" maxWidth="380.0"/>
        <Label text="Descrição:"/>
        <TextArea fx:id="descricao" promptText="Descrição do item" prefHeight="80.0" maxWidth="380.0" wrapText="true"/>
        <Label text="Preço:"/>
        <TextField fx:id="campoPreco" promptText="Ex: 25.90" maxWidth="380.0"/>
        <Label text="Categoria:"/>
        <ComboBox fx:id="categoria" maxWidth="380.0"/>
        <CheckBox fx:id="disponivel" text="Disponível" selected="true"/>
        <ImageView fx:id="imagem" fitHeight="140.0" fitWidth="200.0" preserveRatio="true"/>
        <Button fx:id="escolherImagem" text="Escolher Imagem" onAction="#escolherImagem" prefWidth="180.0"/>
        <HBox alignment="CENTER" spacing="15.0">
            <Button fx:id="salvar" text="Salvar" onAction="#salvar" prefWidth="120.0"/>
            <Button text="Cancelar" onAction="#cancelar" prefWidth="120.0"/>
        </HBox>
    </VBox>
</StackPane>
